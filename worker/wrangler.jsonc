{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masuda-verdict-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "PER_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "BOOKMARKS_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ]
}
